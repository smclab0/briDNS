$ORIGIN home.lan.
$TTL 3600
@       IN  SOA ns1.home.lan. hostmaster.home.lan. (
                2026102301 ; serial (YYYYMMDDnn)
                3600       ; refresh
                900        ; retry
                1209600    ; expire
                300 )      ; negative cache TTL
        IN  NS      ns1.home.lan.
        IN  MX  10  mail.home.lan.
ns1     IN  A       192.168.1.2
router  IN  A       192.168.1.1
nas     IN  A       192.168.1.20
mail    IN  A       192.168.1.25
www     IN  CNAME   nas.home.lan.
@       IN  TXT     "v=spf1 mx -all"
