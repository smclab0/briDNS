# Copy to .env and set a strong password. .env is kept out of git.
BRIDNS_ADMIN_USER=admin
BRIDNS_ADMIN_PASSWORD=change-me
# Signs session cookies. Set it so sign-ins survive container restarts: openssl rand -hex 32
BRIDNS_SECRET=
BRIDNS_SESSION_HOURS=8
# Set to true once briDNS is served over HTTPS
BRIDNS_COOKIE_SECURE=false
